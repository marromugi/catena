{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "error"
  },
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["../*/*", "./../**", "../../**"],
            "message": "Import another module through its index, as \"../<module>\", not a file inside it or a longer way round."
          }
        ]
      }
    ],
    "import/no-cycle": [
      "error",
      {
        "ignoreTypes": false
      }
    ]
  },
  "env": {
    "builtin": true
  },
  "overrides": [
    {
      "files": ["packages/catena/src/layout/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../**", "./../**"],
                "message": "layout holds the types the other modules share, so it imports nothing outside layout."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/catena/src/svg/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../**", "./../**"],
                "message": "svg writes the elements every module draws, so it imports nothing outside svg."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/catena/src/verify/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../*/*", "./../**", "../../**"],
                "message": "Import another module through its index, as \"../<module>\", not a file inside it or a longer way round."
              },
              {
                "group": ["**/place", "**/place/**"],
                "message": "verify shares no code with the placement it checks."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/catena/src/place/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../*/*", "./../**", "../../**"],
                "message": "Import another module through its index, as \"../<module>\", not a file inside it or a longer way round."
              },
              {
                "group": ["**/verify", "**/verify/**"],
                "message": "Placement shares no code with verify, which checks it. Only its tests call verify."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/catena/src/place/**/*.test.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../*/*", "./../**", "../../**"],
                "message": "Import another module through its index, as \"../<module>\", not a file inside it or a longer way round."
              }
            ]
          }
        ]
      }
    }
  ]
}
